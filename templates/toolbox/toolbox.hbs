<div class="items">
  {{#each actors as |actor|}}
    <div class="actor-resume">
      <h3>{{actor.name}}</h3>
      <div class="score-container">
        {{#iff actor.type '!=' 'dangerpts'}}
          <div>
            <label class="icon-label"><i class="fa-solid fa-star-of-life" data-tooltip="{{capitalize (localize "SVNSEA2E.Raises")}}"></i></label>
            <span>{{actor.system.initiative}}</span>
          </div>
          <div>
            <label class="icon-label"><i class="fa-solid fa-sun" data-tooltip="{{capitalize (localize "SVNSEA2E.HeroPoints")}}"></i></label>
            <span>{{actor.system.heropts}}</span>
          </div>
        {{else}}
          <div>
            <label class="icon-label"><i class="fa-solid fa-skull" data-tooltip="{{capitalize (localize "SVNSEA2E.DangerPoints")}}"></i></label>
            <span>{{actor.system.points}}</span>
          </div>
        {{/iff}}
        <a class="remove-actor" data-action="removeActor" data-uuid="{{actor.uuid}}" data-tooltip="{{localize "SVNSEA2E.RemoveFromToolbox"}}"><i class="fa-solid fa-xmark"></i></a>
      </div>
    </div>
  {{else}}
    <p>{{localize "SVNSEA2E.EmptyToolbox"}}</p>
  {{/each}}
</div>
