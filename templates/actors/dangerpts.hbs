<div class="sheet-content {{cssClass}}">
  <header class="sheet-header dangerpts">
    <img class="profile-img" src="systems/svnsea2e/icons/dangerpts.jpg" alt="{{localize 'SVNSEA2E.DangerPoints'}}" />
    <div class="header-fields">
      <h1 class="dangerpts-title">{{localize "SVNSEA2E.DangerPoints"}}</h1>
    </div>
  </header>

  <section class="sheet-body danger-points">
    <div class="grid grid-3col">
      <div class="flex-group-left">
        <button type="button" data-action="adjustPoints" data-delta="-2"><i class="fa-solid fa-minus"></i><i class="fa-solid fa-minus"></i></button>
        <button type="button" data-action="adjustPoints" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
      </div>
      <div class="flex-group-center">
        <input type="number" name="system.points" value="{{points}}" min="0" step="1" />
      </div>
      <div class="flex-group-right">
        <button type="button" data-action="adjustPoints" data-delta="1"><i class="fa-solid fa-plus"></i></button>
        <button type="button" data-action="adjustPoints" data-delta="2"><i class="fa-solid fa-plus"></i><i class="fa-solid fa-plus"></i></button>
      </div>
    </div>
  </section>
</div>
