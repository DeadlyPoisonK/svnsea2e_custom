<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <div class="header-concept">
      <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
      <div class="header-fields">
        {{> "systems/svnsea2e/templates/actors/parts/actor-name.hbs"}}
        <div class="form-group flex-group">
          <span class="flex-group">
            <label for="{{actor.id}}-class">{{localize "SVNSEA2E.Class"}}</label>
            <input type="text" id="{{actor.id}}-class" name="system.class" value="{{system.class}}" placeholder="{{localize 'SVNSEA2E.Class'}}" />
          </span>
          <span class="flex-group">
            <label for="{{actor.id}}-origin">{{localize "SVNSEA2E.Origin"}}</label>
            <input type="text" id="{{actor.id}}-origin" name="system.origin" value="{{system.origin}}" placeholder="{{localize 'SVNSEA2E.Origin'}}" />
          </span>
        </div>
      </div>
    </div>
    <div class="grid grid-2col">
      <div class="form-group flex-group-left">
        <label for="{{actor.id}}-crewstatus">{{localize "SVNSEA2E.CrewStatus"}}</label>
        <select id="{{actor.id}}-crewstatus" class="crewstatus" name="system.crewstatus">
          {{selectOptions config.crewStatuses selected=system.crewstatus localize=true}}
        </select>
      </div>
      <div class="form-group flex-group">
        <label for="{{actor.id}}-wealth">{{localize "SVNSEA2E.WealthPts"}}</label>
        <input type="number" id="{{actor.id}}-wealth" name="system.wealth" value="{{system.wealth}}" min="0" step="1" />
      </div>
    </div>
    {{> "systems/svnsea2e/templates/actors/parts/actor-wounds.hbs"}}
  </header>

  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}

  <section class="sheet-body">
    <div class="tab roster {{tabs.roster.cssClass}}" data-group="primary" data-tab="roster">
      <ol class="items-list crew">
        {{#each crew as |role|}}
          <li class="flexrow item-header {{role.cssClass}}" data-role="{{role.role}}">
            <h3 class="item-name flexrow">{{role.label}}</h3>
          </li>
          {{#each role.actors as |member|}}
            <li class="item flexrow draggable {{role.cssClass}}" data-actor-id="{{member.id}}">
              <div class="item-image"><img src="{{member.img}}" alt="{{member.name}}" /></div>
              <h4 class="item-name">{{member.name}}</h4>
              <div class="item-controls">
                {{#if @root.editable}}
                  <a class="item-control item-delete" data-action="removeCrew" data-tooltip="{{localize 'SVNSEA2E.RemoveCrew'}}"><i class="fa-solid fa-trash"></i></a>
                {{/if}}
              </div>
            </li>
          {{/each}}
        {{/each}}
      </ol>
    </div>
    <div class="tab cargo {{tabs.cargo.cssClass}}" data-group="primary" data-tab="cargo">
      {{#if editable}}
        <prose-mirror name="system.cargo" value="{{system.cargo}}" data-document-uuid="{{actor.uuid}}" toggled>{{{enrichedCargo}}}</prose-mirror>
      {{else}}
        <div class="editor-content">{{{enrichedCargo}}}</div>
      {{/if}}
    </div>
    <div class="tab features {{tabs.features.cssClass}}" data-group="primary" data-tab="features">
      <ol class="items-list">
        {{#each itemLists.features as |section|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-list.hbs" section=section}}
        {{/each}}
      </ol>
    </div>
    {{> "systems/svnsea2e/templates/parts/effects-tab.hbs"}}
  </section>
</div>
