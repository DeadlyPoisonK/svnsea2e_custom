<div class="sheet-content flexcol brute {{cssClass}}">
  <header class="sheet-header">
    <div class="header-concept">
      <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
      <div class="header-fields">
        <h1 class="charname"><input name="name" type="text" value="{{name}}" placeholder="{{localize 'SVNSEA2E.ActorName'}}" /></h1>
        <div class="resources flex-group-left wound-title">{{localize "SVNSEA2E.Wounds"}}</div>
        <div class="resources flex-group-left wounds">
          {{#for 1 system.wounds.max 1}}
            <i data-action="setWounds" data-value="{{@index}}" data-type="wounds" class="fillable {{#iff system.wounds.value '>=' @index}}fa-solid{{else}}fa-regular{{/iff}} fa-heart fa-lg"></i>
          {{/for}}
          <div class="flex-group">
            <button type="button" class="roll-throw" data-action="freeRoll">{{localize "SVNSEA2E.RollDice"}}</button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="sheet-body ability">
    <h3 class="trait-title">{{localize "SVNSEA2E.Traits"}}</h3>
    {{#each traits as |trait|}}
      <div class="trait flexrow flex-group flex-left">
        <span class="trait-name rollableT" data-action="rollTrait" data-label="{{trait.name}}">{{trait.label}}</span>
        {{> "systems/svnsea2e/templates/actors/parts/rank-circles.hbs" value=trait.value max=trait.max path=(concat "system.traits." trait.name ".value") type="trait" key=trait.name}}
      </div>
    {{/each}}
    <div class="features">
      <ol class="items-list">
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="advantage" label="SVNSEA2E.Advantage" type="advantage" addTitle="SVNSEA2E.AddAdvantage"}}
        {{#each advantages as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="advantage" used=true}}
        {{/each}}
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="duelstyle" label="SVNSEA2E.DuelingStyles" type="duelstyle" addTitle="SVNSEA2E.AddDuelStyle" cssClass="duelingstyle"}}
        {{#each duelstyles as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="duelingstyle" used=true}}
        {{/each}}
      </ol>
    </div>
  </section>
</div>
