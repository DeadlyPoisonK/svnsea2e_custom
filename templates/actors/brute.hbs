<form class="{{cssClass}} flexcol brute" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="header-concept">
      <img class="profile-img" src="{{img}}" data-edit="img" title="{{name}}" />
      <div class="header-fields">
        <h1 class="charname"><input name="name" type="text" value="{{name}}" placeholder="{{localize 'SVNSEA2E.ActorName'}}" /></h1>
        <div class="resources flex-group-left wound-title">
          {{localize "SVNSEA2E.Wounds" }}
        </div>
        <div class="resources flex-group-left wounds">
          {{#for 1 wounds.max 1}}
            {{#iff wounds.value '>=' @index}}
              <i data-name="system.wounds.value" data-value="{{@index}}" data-type="wounds" class="fillable fas fa-heart fa-lg"></i>
            {{else}}
              <i data-name="system.wounds.value" data-value="{{@index}}" data-type="wounds" class="fillable far fa-heart fa-lg"></i>
            {{/iff}}
          {{/for}}
          <span class="wounds-counter" style="margin-left: 10px; font-weight: bold; align-self: center;">{{woundsRemaining}}/{{wounds.max}}</span>
          <div class="flex-group">
            <button type="button" class="roll-throw">Roll Dice</button>
           </div>
        </div>
      </div>
  </div>
   
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body ability">
    {{!-- Ability Tab --}}
    <h3 class="trait-title">{{localize "SVNSEA2E.Traits"}}</h3>
    {{#each traits as |trait key|}}
      <div class="trait flexrow flex-group flex-left">
        <span class="trait-name rollableT" data-label="{{trait.name}}">{{trait.label}}</span>
        <span>
        {{#for 1 trait.max 1}}
          {{#iff trait.value '>=' @index}}
            <i data-name="system.traits.{{trait.name}}.value" data-value="{{@index}}" data-type="trait" data-key="{{trait.name}}" class="fillable fas fa-circle"></i>
          {{else}}
            <i data-name="system.traits.{{trait.name}}.value" data-value="{{@index}}" data-type="trait" data-key="{{trait.name}}" class="fillable far fa-circle"></i>
          {{/iff}}
        {{/for}}
        </span>
      </div>
    {{/each}}
    <div class="features" style="margin-top: 10px;">
      <ol class="items-list">
        
        <li class="flexrow item-header">
          <h3 class="item-name flexrow">{{localize "SVNSEA2E.Advantage"}}</h3>
          <div class="item-controls">
            <a class="item-control item-create" title="{{ localize 'SVNSEA2E.AddAdvantage' }}" data-type="advantage" {{#each section.dataset as |v k|}}data-{{k}}="{{v}}" {{/each}}>
              <i class="fas fa-plus"></i> {{localize "SVNSEA2E.Add"}}
            </a>
          </div>
        </li>
        {{#each advantages as |item id|}}
        <li class="item flexrow advantage" data-item-id="{{item._id}}">
          <div class="item-image item-throw"><img src="{{item.img}}" title="{{item.name}}" /></div>
          <h4 class="item-name">{{item.name}}{{#if item.system.knack}}<span title="{{localize 'SVNSEA2E.Knack'}}"><i class="fas fa-award"></i></span>{{/if}}</h4>
          <div class="item-controls">
            <input type="checkbox" class="item-control item-check" title="{{localize 'SVNSEA2E.Used'}}" {{checked item.system.used}} />
            <a class="item-control item-edit" title="{{item.editlabel}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{item.deletelabel}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}

        <li class="flexrow item-header duelingstyle">
          <h3 class="item-name flexrow">{{localize "SVNSEA2E.DuelingStyles"}}</h3>
          <div class="item-controls">
            <a class="item-control item-create" title="{{localize 'SVNSEA2E.AddDuelStyle'}}" data-type="duelstyle" {{#each section.dataset as |v k|}}data-{{k}}="{{v}}"{{/each}}>
                <i class="fas fa-plus"></i> {{localize "SVNSEA2E.Add"}}
            </a>
          </div>
        </li>
        {{#each duelstyles as |item id|}}
        <li class="item flexrow duelingstyle" data-item-id="{{item._id}}">
          <div class="item-image item-throw"><img src="{{item.img}}" title="{{item.name}}" /></div>
          <h4 class="item-name">{{item.name}}</h4>
          <div class="item-controls">
            <input type="checkbox" class="item-control item-check" title="{{localize 'SVNSEA2E.Used'}}" {{checked item.system.used}} /> 
            <a class="item-control item-edit" title="{{item.editlabel}}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="{{item.deletelabel}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
        
      </ol>
    </div>
  </section>
</form>
