<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <div class="header-concept">
      <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
      <div class="header-fields">
        {{> "systems/svnsea2e/templates/actors/parts/actor-name.hbs"}}
        {{> "systems/svnsea2e/templates/actors/parts/actor-wounds.hbs"}}
        {{> "systems/svnsea2e/templates/actors/parts/actor-villainy.hbs"}}
      </div>
    </div>
  </header>

  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}

  <section class="sheet-body">
    <div class="tab traits {{tabs.traits.cssClass}}" data-group="primary" data-tab="traits">
      {{> "systems/svnsea2e/templates/actors/parts/actor-vtraits.hbs"}}
    </div>

    <div class="tab features {{tabs.advantages.cssClass}}" data-group="primary" data-tab="advantages">
      <ol class="items-list">
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="advantage" label="SVNSEA2E.Advantage" type="advantage" addTitle="SVNSEA2E.AddAdvantage" cssClass="advantage"}}
        {{#each advantages as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="advantage" used=true}}
        {{/each}}
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="duelstyle" label="SVNSEA2E.DuelingStyles" type="duelstyle" addTitle="SVNSEA2E.AddDuelStyle" cssClass="duelingstyle"}}
        {{#each duelstyles as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="duelingstyle" used=true}}
        {{/each}}
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="monsterquality" label="SVNSEA2E.MonsterQualities" type="monsterquality" addTitle="SVNSEA2E.AddMonsterQuality"}}
        {{#each monsterqualities as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item used=true}}
        {{/each}}
        {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="scheme" label="SVNSEA2E.Schemes" type="scheme" addTitle="SVNSEA2E.AddScheme"}}
        {{#each schemes as |item|}}
          {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item used=true}}
        {{/each}}
      </ol>
    </div>

    {{> "systems/svnsea2e/templates/actors/parts/actor-sorcery.hbs"}}
    {{> "systems/svnsea2e/templates/actors/parts/actor-inventory.hbs"}}
    {{> "systems/svnsea2e/templates/actors/parts/actor-fate.hbs"}}
    {{> "systems/svnsea2e/templates/actors/parts/actor-concept.hbs"}}
  </section>
</div>
