<div class="tab fate {{tabs.fate.cssClass}}" data-group="primary" data-tab="fate">
  {{#each itemLists.fate as |section|}}
    <ol class="items-list">
      {{> "systems/svnsea2e/templates/actors/parts/item-list.hbs" section=section}}
    </ol>
  {{/each}}
  {{#if isPlayerCharacter}}
    {{#if isCorrupt}}
      <div class="redemption flexrow flex-group">
        <label for="{{actor.id}}-redemption"><h3 class="item-name">{{localize "SVNSEA2E.Redemption"}}</h3></label>
      </div>
      <div class="redemption flexrow flex-group flex-between">
        <textarea id="{{actor.id}}-redemption" name="system.redemption">{{system.redemption}}</textarea>
      </div>
    {{/if}}
  {{/if}}
  {{#if isVillain}}
    <div class="redemption flexrow flex-group">
      <h3>{{localize "SVNSEA2E.Redemption"}}</h3>
    </div>
    <div class="redemption flexrow flex-group flex-between">
      <textarea id="{{actor.id}}-redemption" name="system.redemption">{{system.redemption}}</textarea>
    </div>
  {{/if}}
</div>
