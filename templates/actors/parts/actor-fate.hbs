<div class="tab fate {{tabs.fate.cssClass}}" data-group="primary" data-tab="fate">
  <ol class="items-list">
    {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="virtue" label="SVNSEA2E.Virtue" type="virtue" addTitle="SVNSEA2E.AddVirtue" cssClass="story"}}
    {{#each virtues as |item|}}
      {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="story" used=true}}
    {{/each}}
    {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="hubris" label="SVNSEA2E.Hubris" type="hubris" addTitle="SVNSEA2E.AddHubris" cssClass="story"}}
    {{#each hubriss as |item|}}
      {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="story" used=true}}
    {{/each}}
    {{#if isPlayerCharacter}}
      {{> "systems/svnsea2e/templates/actors/parts/item-section.hbs" section="story" label="SVNSEA2E.Stories" type="story" addTitle="SVNSEA2E.AddStory" cssClass="story"}}
      {{#each stories as |item|}}
        {{> "systems/svnsea2e/templates/actors/parts/item-row.hbs" item=item rowClass="story"}}
      {{/each}}
    {{/if}}
  </ol>
  {{#if isPlayerCharacter}}
    {{#if isCorrupt}}
      <div class="redemption flexrow flex-group">
        <label for="{{actor.id}}-redemption"><h3 class="item-name">{{localize "SVNSEA2E.Redemption"}}</h3></label>
      </div>
      <div class="redemption flexrow flex-group flex-between">
        <textarea id="{{actor.id}}-redemption" name="system.redemption">{{redemption}}</textarea>
      </div>
    {{/if}}
  {{/if}}
  {{#if isVillain}}
    <div class="redemption flexrow flex-group">
      <label for="{{actor.id}}-redemption"><h3 class="item-name">{{localize "SVNSEA2E.Redemption"}}</h3></label>
    </div>
    <div class="redemption flexrow flex-group flex-between">
      <textarea id="{{actor.id}}-redemption" name="system.redemption">{{redemption}}</textarea>
    </div>
  {{/if}}
</div>
