{{#if isPlayerCharacter}}
  <div class="form-group flex-group">
    <span class="flex-group corruption">
    <label>{{ localize "SVNSEA2E.CorruptionPoints" }}</label>
    {{#for 1 10 1}}
      {{#iff corruptionpts '>=' @index}}
        <i data-name="system.corruptionpts" data-value="{{@index}}" data-type="corrupt" data-key="corruptionpts" class="fillable fas fa-circle"></i>
      {{else}}
        <i data-name="system.corruptionpts" data-value="{{@index}}" data-type="corrupt" data-key="corruptionpts" class="fillable far fa-circle"></i>
      {{/iff}}
    {{/for}}
    </span>
    {{!-- Hero Points --}}
    <div class="flex-group">
      <label for="system.heropts" class="icon-label"><i class="fas fa-sun" title="{{localize "SVNSEA2E.HeroPoints"}}"></i></label>
      <span class="twodigit herospts">
        <input type="text" name="system.heropts" value="{{heropts}}" id="system.heropts"/>
      </span>
    </div>
    {{!-- Wealth --}}
    <div class="flex-group">
      <label for="system.wealth" class="icon-label"><i class="fas fa-coins" title="{{localize "SVNSEA2E.WealthPts"}}"></i></label>
      <span class="twodigit wealth">
        <input type="text" name="system.wealth" value="{{wealth}}" data-dtype="String" id="system.wealth" />
      </span>
    </div>
    {{!-- ARREGLO: HARD TO KILL (HtK) HEROES --}}
    <a class="htk-control" title="Activar Hard To Kill (25 Heridas)">
      {{#if actor.system.htk}}
          <span class="htk-on">
              <i class="fas fa-heart"></i> HTK: ON
          </span>
      {{else}}
          <span class="htk-off">
              <i class="fas fa-heart-broken"></i> HTK: OFF
          </span>
      {{/if}}
    </a>
    
    {{!-- Initiative --}}
    <div class="flex-group raise-tracking">
      <label for="system.initiative">{{ localize "SVNSEA2E.Initiative" }}</label>
      <span class="twodigit">
        <button type="button" class="minus-1-initiative">-1</button>
        <input class="initiative-input" type="number" name="system.initiative" value="{{initiative}}" id="system.initiative" step="1"/>
        <button type="button" class="add-1-initiative">+1</button>
      </span>
    </div>
  </div>
{{/if}}

{{!-- NUEVO BLOQUE: HARD TO KILL (HtK) PARA VILLANOS --}}
{{#if isVillain}}
  <div class="flex-group-left" style="margin-bottom: 5px;">
    <a class="htk-control" title="Activar Duro de Matar (Añade 1 Herida Dramática extra)">
      {{#if actor.system.htk}}
          <span class="htk-on" style="color: green; font-weight: bold;"><i class="fas fa-heart"></i> HTK: ON</span>
      {{else}}
          <span class="htk-off" style="color: gray;"><i class="fas fa-heart-broken"></i> HTK: OFF</span>
      {{/if}}
    </a>
  </div>
{{/if}}
{{!-- FIN DEL NUEVO BLOQUE --}}

<div class="flex-group-left wounds">
  {{localize "SVNSEA2E.Wounds" }}
  {{#for 1 wounds.max 1}}
    {{#iff @remain '!=' 0}}
      {{#iff wounds.value '>=' @index}}
        <i data-name="system.wounds.value" data-value="{{@index}}" data-type="wounds" class="fillable fas fa-heart fa-lg"></i>
      {{else}}
        <i data-name="system.wounds.value" data-value="{{@index}}" data-type="wounds" class="fillable far fa-heart fa-lg"></i>
      {{/iff}}
    {{else}}
      {{#if isNotBrute}}
        {{#iff dwounds.value '>=' @mod}}
          <i data-name="system.dwounds.value" data-value="{{@mod}}" data-type="dwounds" class="fillable fas fa-heart red fa-lg"></i>
        {{else}}
          <i data-name="system.dwounds.value" data-value="{{@mod}}" data-type="dwounds" class="fillable far fa-heart red fa-lg"></i>
        {{/iff}}
      {{/if}}
    {{/iff}}
  {{/for}}
  <span class="wounds-counter" style="margin-left: 10px; font-weight: bold; align-self: center;">{{woundsRemaining}}/{{wounds.max}}</span>
</div>
<div class="flex-group">
  <button type="button" class="roll-throw">Roll Dice</button>
</div>