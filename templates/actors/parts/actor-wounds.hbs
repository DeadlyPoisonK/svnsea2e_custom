{{#if isPlayerCharacter}}
  <div class="form-group flex-group">
    <span class="flex-group corruption">
      <label>{{localize "SVNSEA2E.CorruptionPoints"}}</label>
      {{#for 1 10 1}}
        <i data-action="setRank" data-name="system.corruptionpts" data-value="{{@index}}" class="fillable {{#iff system.corruptionpts '>=' @index}}fa-solid{{else}}fa-regular{{/iff}} fa-circle"></i>
      {{/for}}
    </span>
    {{!-- Hero Points --}}
    <div class="flex-group">
      <label for="{{actor.id}}-heropts" class="icon-label"><i class="fa-solid fa-sun" data-tooltip="{{localize "SVNSEA2E.HeroPoints"}}"></i></label>
      <span class="twodigit herospts">
        <input type="number" name="system.heropts" value="{{system.heropts}}" id="{{actor.id}}-heropts" min="0" step="1" />
      </span>
    </div>
    {{!-- Wealth --}}
    <div class="flex-group">
      <label for="{{actor.id}}-wealth" class="icon-label"><i class="fa-solid fa-coins" data-tooltip="{{localize "SVNSEA2E.WealthPts"}}"></i></label>
      <span class="twodigit wealth">
        <input type="number" name="system.wealth" value="{{system.wealth}}" id="{{actor.id}}-wealth" min="0" step="1" />
      </span>
    </div>
    {{!-- Hard To Kill --}}
    <a class="htk-control" data-action="toggleHtk" data-tooltip="{{localize "SVNSEA2E.HtkToggleTooltip"}}">
      {{#if system.htk}}
        <span class="htk-on"><i class="fa-solid fa-heart"></i> {{localize "SVNSEA2E.HtkOn"}}</span>
      {{else}}
        <span class="htk-off"><i class="fa-solid fa-heart-crack"></i> {{localize "SVNSEA2E.HtkOff"}}</span>
      {{/if}}
    </a>
  </div>
{{/if}}

{{#if isVillain}}
  <div class="flex-group-left htk-row">
    <a class="htk-control" data-action="toggleHtk" data-tooltip="{{localize "SVNSEA2E.HtkToggleVillainTooltip"}}">
      {{#if system.htk}}
        <span class="htk-on"><i class="fa-solid fa-heart"></i> {{localize "SVNSEA2E.HtkOn"}}</span>
      {{else}}
        <span class="htk-off"><i class="fa-solid fa-heart-crack"></i> {{localize "SVNSEA2E.HtkOff"}}</span>
      {{/if}}
    </a>
  </div>
{{/if}}

{{!-- Wound track: every group ends with a dramatic wound (red heart). --}}
<div class="flex-group-left wounds">
  {{localize "SVNSEA2E.Wounds"}}
  {{#for 1 system.wounds.max 1 group=system.woundsPerDramatic}}
    {{#iff @remain '!=' 0}}
      <i data-action="setWounds" data-value="{{@index}}" data-type="wounds" class="fillable {{#iff system.wounds.value '>=' @index}}fa-solid{{else}}fa-regular{{/iff}} fa-heart fa-lg"></i>
    {{else}}
      <i data-action="setWounds" data-value="{{@mod}}" data-type="dwounds" class="fillable {{#iff system.dwounds.value '>=' @mod}}fa-solid{{else}}fa-regular{{/iff}} fa-heart red fa-lg"></i>
    {{/iff}}
  {{/for}}
</div>
<div class="flex-group">
  <button type="button" class="roll-throw" data-action="freeRoll">{{localize "SVNSEA2E.RollDice"}}</button>
</div>
