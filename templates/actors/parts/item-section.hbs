{{!-- Header of an item list section. Hash: section, label (optional), type (item type created by "Add"), addTitle, cssClass --}}
<li class="flexrow item-header {{cssClass}}" data-action="toggleSection" data-section="{{section}}">
  {{#if label}}<h3 class="item-name flexrow">{{localize label}}</h3>{{else}}<div class="item-name flexrow"></div>{{/if}}
  {{#if @root.editable}}
    <div class="item-controls">
      <a class="item-control item-create" data-action="createItem" data-type="{{type}}" data-tooltip="{{localize addTitle}}">
        <i class="fa-solid fa-plus"></i> {{localize "SVNSEA2E.Add"}}
      </a>
    </div>
  {{/if}}
</li>
