<div class="tab traits {{tabs.traits.cssClass}}" data-group="primary" data-tab="traits">
  <h3 class="trait-title">{{localize "SVNSEA2E.Traits"}}</h3>
  <div class="traits grid grid-3col">
    {{#each traits as |trait|}}
      <div class="trait flexrow flex-group flex-left">
        <span class="trait-name rollableT" data-action="rollTrait" data-label="{{trait.name}}">{{trait.label}}</span>
        {{> "systems/svnsea2e/templates/actors/parts/rank-circles.hbs" value=trait.value max=trait.max path=(concat "system.traits." trait.name ".value") type="trait" key=trait.name}}
      </div>
    {{/each}}
  </div>
  {{#if hasSkills}}
    <h3 class="skill-title">{{localize "SVNSEA2E.Skills"}}</h3>
    <div class="skills">
      {{#each skills as |skill|}}
        <div class="skill flexrow flex-group flex-left">
          <span class="skill-name rollable" data-action="rollSkill" data-label="{{skill.name}}">{{skill.label}}</span>
          {{> "systems/svnsea2e/templates/actors/parts/rank-circles.hbs" value=skill.value max=skill.max path=(concat "system.skills." skill.name ".value") type="skill" key=skill.name}}
        </div>
      {{/each}}
    </div>
    <div class="skills-comment grid grid-3col">
      <div class="skill flexrow flex-group flex-left">{{localize "SVNSEA2E.SkillRank3"}}</div>
      <div class="skill flexrow flex-group flex-left">{{localize "SVNSEA2E.SkillRank4"}}</div>
      <div class="skill flexrow flex-group flex-left">{{localize "SVNSEA2E.SkillRank5"}}</div>
    </div>
  {{/if}}
  {{#if hasLanguages}}
    {{> "systems/svnsea2e/templates/actors/parts/actor-languages.hbs"}}
  {{/if}}
</div>
