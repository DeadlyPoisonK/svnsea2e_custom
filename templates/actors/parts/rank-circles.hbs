{{!-- Clickable rank circles. Hash: value, max, path (field to update), type, key --}}
<span class="rank-circles">
  {{#for 1 max 1}}
    <i data-action="setRank" data-name="{{path}}" data-value="{{@index}}" data-type="{{type}}" data-key="{{key}}" class="fillable {{#iff value '>=' @index}}fa-solid{{else}}fa-regular{{/iff}} fa-circle"></i>
  {{/for}}
</span>
