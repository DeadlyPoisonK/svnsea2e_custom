{{!-- Rank circles. Hash: value, max, path (field to update), type, key, locked (changed by an active effect: shown, not editable) --}}
<span class="rank-circles{{#if locked}} locked{{/if}}"{{#if locked}} data-tooltip="{{localize 'SVNSEA2E.EffectModified'}}"{{/if}}>
  {{#for 1 max 1}}
    <i {{#unless locked}}data-action="setRank" {{/unless}}data-name="{{path}}" data-value="{{@index}}" data-type="{{type}}" data-key="{{key}}" class="{{#unless locked}}fillable {{/unless}}{{#iff value '>=' @index}}fa-solid{{else}}fa-regular{{/iff}} fa-circle"></i>
  {{/for}}
</span>
