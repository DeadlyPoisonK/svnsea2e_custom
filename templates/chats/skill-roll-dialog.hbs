<div class="roll-dialog">
  {{#if bonus.effects}}<p class="hint roll-effects">{{localize "SVNSEA2E.RollEffects"}}: {{bonus.effects}}</p>{{/if}}
  <div class="form-group">
    <label for="svnsea2e-roll-trait">{{localize "SVNSEA2E.Trait"}}</label>
    <select id="svnsea2e-roll-trait" name="trait">
      {{#each traits as |value label|}}
        <option value="{{value}}">{{label}}</option>
      {{/each}}
    </select>
  </div>
  <fieldset>
    <legend>{{localize "SVNSEA2E.Bonus"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-flair">{{localize "SVNSEA2E.FlairDice"}}</label>
      <input type="checkbox" id="svnsea2e-roll-flair" name="flairDice" value="1" />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-interpretation">{{localize "SVNSEA2E.InterpretationDice"}}</label>
      <input type="checkbox" id="svnsea2e-roll-interpretation" name="interpretationDice" value="1" />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-bonus">{{localize "SVNSEA2E.BonusDice"}}</label>
      <input type="number" id="svnsea2e-roll-bonus" name="bonusDice" value="{{bonus.dice}}" step="1" />
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "SVNSEA2E.HeroPoints"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-useforme">{{localize "SVNSEA2E.UseForMe"}}</label>
      <input type="number" id="svnsea2e-roll-useforme" name="useForMe" value="0" min="0" step="1" />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-helpme">{{localize "SVNSEA2E.UseForHelpMe"}}</label>
      <input type="number" id="svnsea2e-roll-helpme" name="useForHelpMe" value="0" min="0" step="1" />
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "SVNSEA2E.Advantages"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-addone">{{localize "SVNSEA2E.AddOneToDice"}}</label>
      <input type="checkbox" id="svnsea2e-roll-addone" name="addOneToDice" value="1" {{checked bonus.addOne}} />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-joie">{{localize "SVNSEA2E.JoieDeVivre"}}</label>
      <input type="checkbox" id="svnsea2e-roll-joie" name="joieDeVivreAdvantage" value="1" {{checked bonus.joieDeVivre}} />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-explode">{{localize "SVNSEA2E.ExplodeTens"}}</label>
      <input type="checkbox" id="svnsea2e-roll-explode" name="explodeDice" value="1" {{checked bonus.explode}} />
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "SVNSEA2E.DangerPoints"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-threshold">{{localize "SVNSEA2E.IncreaseThreshold"}}</label>
      <input type="checkbox" id="svnsea2e-roll-threshold" name="increaseThreshold" value="1" {{checked bonus.increaseThreshold}} />
    </div>
  </fieldset>
</div>
