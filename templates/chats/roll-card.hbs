<div>
  <div class="chat-card skill-roll dice-roll" data-actor-uuid="{{ actorUuid }}">
    <div class="dice-result">
      <h4 class="dice-total">{{ raises }} {{ raisetxt }} - {{ unusedDice }} {{ unusedDiceTxt }} </h4>
      <div class="dice-tooltip">
        <section class="tooltip-part">
          <div class="dice">
            <ol class="dice-rolls">
              {{#each dice as |die|}}
                <li class="roll die d10{{#if die.joie}} joie{{/if}}"{{#if die.joie}} data-tooltip="{{localize 'SVNSEA2E.JoieCountsAsTen'}}"{{/if}}> {{ die.face }}</li>
              {{/each}}
            </ol>

            <h6>{{localize "SVNSEA2E.RaiseCombos"}}</h6>
            <div class="flexrow flex-group flex-left">
              <ul class="raise-combos-list">
                {{#each combos as |combo|}}
                  <li class="combo"> {{ combo }}</li>
                {{/each}}
              </ul>
            </div>
            {{#if unusedRolls.length}}
            <h6>{{localize "SVNSEA2E.UnusedDice"}}</h6>
            <div class="flexrow flex-group flex-left">
              <ul class="raise-combos-list">
                {{#each unusedRolls as |ur|}}
                  <li class="combo unused">{{ ur }}</li>
                {{/each}}
              </ul>
            </div>
            {{/if}}
            {{#if reroll}}
              <div class="rerolled">
                {{ reroll }}
              </div>
            {{/if}}
            {{#if exploded}}
              <div class="explosions">
                {{localize "SVNSEA2E.RollsExploded"}}
                {{#if extraDice}}
                  <br><strong>(+{{ extraDice }} {{localize "SVNSEA2E.ExtraDiceExploded"}})</strong>
                {{/if}}
              </div>
            {{/if}}
            {{#if addOne}}
              {{localize "SVNSEA2E.AddOneToDiced"}}
            {{/if}}
            {{#if joie}}
              <div class="joie-de-vivre">{{ joie }}</div>
            {{/if}}
            <div class="threshold">{{ threshold }}</div>
            {{#if edited}}
              <div class="roll-edited"><i class="fa-solid fa-pen-to-square"></i> {{localize "SVNSEA2E.RollEdited"}}</div>
            {{/if}}
          </div>
        </section>
      </div>
    </div>
  </div>
  <button class="initiative-tracker-add" data-raise="{{ raises }}" data-actor="{{ actorUuid }}">
    {{ localize "SVNSEA2E.AddToInitiativeTracker" }}
  </button>
</div>
