<div>
  <div class="chat-card skill-roll dice-roll" data-actor-id="{{ actor.id }}">
    <div class="dice-result">
      <h4 class="dice-total">{{ raises }} {{ raisetxt }} - {{ unusedDice }} {{ unusedDiceTxt }} </h4>
      <div class="dice-tooltip">
        <section class="tooltip-part">
          <div class="dice">
            <ol class="dice-rolls">
              {{#each rolls as |roll|}}
                <li class="roll die d10"> {{ roll }}</li>
              {{/each}}
            </ol>
            
            <h6>{{ rCombos }}</h6>
            <div class="flexrow flex-group flex-left">
              <ul class="raise-combos-list">
                {{#each combos as |combo|}}
                  <li class="combo"> {{ combo }}</li>
                {{/each}}
              </ul>
            </div>
            {{#if unusedRolls.length}}
            <h6>UnusedDices</h6>
            <div class="flexrow flex-group flex-left">
              <ul class="raise-combos-list">
                {{#each unusedRolls as |ur|}}
                  <li class="combo" style="background: rgba(255, 0, 0, 0.1);"> {{ ur }}</li>
                {{/each}}
              </ul>
            </div>
            {{/if}}
            {{#if rerolled}}
              <div class="rerolled">
                {{ reroll }}
              </div>
            {{/if}}
            {{#if exploded}}
              <div class="explosions">
                {{ explosions }}
                {{#if extraDice}}
                  <br><strong>(+{{ extraDice }} dados explotados)</strong>
                {{/if}}
              </div>
            {{/if}}
            {{#if hasAddOneToDice}}
              {{ addOneToDiced }}
            {{/if}}
            <div class="threshold">{{ threshold }}</div>
          </div>
        </section>
      </div>
    </div>
  </div>
  <button class="initiative-tracker-add" data-raise="{{ raises }}" data-actor="{{ actor.id }}">
    {{ localize "SVNSEA2E.AddToInitiativeTracker" }}
  </button>
</div>
