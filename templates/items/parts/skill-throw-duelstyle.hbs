<div class="svnsea2e chat-card item-card">
  
  <header class="card-header">
    <div class="grid-card">
      <img class="card-img" src="{{img}}" title="{{name}}" />
      <h3 class="card-name">{{name}}</h3>
    </div>
  </header>

  <div class="card-content">
    <div class="card-div">
      <label><strong>{{localize 'SVNSEA2E.Bonus'}}:</strong></label>
      <div class="card-description">
         {{{bonus}}}
      </div>
    </div>
    
  </div>
</div>
