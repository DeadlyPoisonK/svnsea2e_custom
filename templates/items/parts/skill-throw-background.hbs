<div class="svnsea2e chat-card item-card">
  
  <header class="card-header">
    <div class="grid-card">
      <img class="card-img" src="{{img}}" title="{{name}}" />
      <h3 class="card-name">{{name}}</h3>
    </div>
  </header>

  <div class="card-content">

    <div class="card-div">
      <label><strong>{{localize 'SVNSEA2E.Description'}}:</strong></label>
      <div class="card-description">
         {{{description}}}
      </div>
    </div>

    <div class="card-div" style="margin-top: 5px;">
      <label><strong>{{localize 'SVNSEA2E.Quirk'}}:</strong></label>
      <div class="card-description">
         {{{quirk}}}
      </div>
    </div>

    </div>
</div>