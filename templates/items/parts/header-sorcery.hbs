<div class="grid grid-2col">
  <div class="form-group flex-group">
    <label for="{{item.id}}-sorctype">{{localize "SVNSEA2E.Type"}}</label>
    <select class="sorcery-type" id="{{item.id}}-sorctype" name="system.sorctype">
      {{selectOptions config.sorceryTypes selected=system.sorctype localize=true}}
    </select>
  </div>
  <div class="form-group flex-group">
    <label for="{{item.id}}-sorcdur">{{localize "SVNSEA2E.Duration"}}</label>
    <select class="sorcery-type" id="{{item.id}}-sorcdur" name="system.sorcdur">
      {{selectOptions config.durations selected=system.sorcdur localize=true}}
    </select>
  </div>
</div>
<div class="relrep grid grid-2col">
  <div class="form-group flex-group">
    <label for="{{item.id}}-sorccat">{{localize "SVNSEA2E.Category"}}</label>
    <select class="sorcery-category" id="{{item.id}}-sorccat" name="system.sorccat">
      {{selectOptions config.sorceryCats selected=system.sorccat localize=true}}
    </select>
  </div>
  <div class="form-group flex-group">
    <label for="{{item.id}}-sorcsubcat">{{localize "SVNSEA2E.SubCategory"}}</label>
    <select class="sorcery-subcategory" id="{{item.id}}-sorcsubcat" name="system.sorcsubcat">
      {{selectOptions config.sorcerySubcats selected=system.sorcsubcat localize=true}}
    </select>
  </div>
</div>
