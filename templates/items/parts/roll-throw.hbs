<div class="roll-dialog free-roll">
  <div class="form-group">
    <label for="svnsea2e-roll-dice">{{localize "SVNSEA2E.DiceNumberLabel"}}</label>
    <input type="number" id="svnsea2e-roll-dice" name="diceNumber" value="1" min="1" step="1" autofocus />
  </div>
  <fieldset>
    <legend>{{localize "SVNSEA2E.Advantages"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-addone">{{localize "SVNSEA2E.AddOneToDice"}}</label>
      <input type="checkbox" id="svnsea2e-roll-addone" name="addOneToDice" value="1" />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-joie">{{localize "SVNSEA2E.JoieDeVivre"}}</label>
      <input type="checkbox" id="svnsea2e-roll-joie" name="joieDeVivreAdvantage" value="1" />
    </div>
    <div class="form-group">
      <label for="svnsea2e-roll-explode">{{localize "SVNSEA2E.ExplodeTens"}}</label>
      <input type="checkbox" id="svnsea2e-roll-explode" name="explodeDice" value="1" />
    </div>
  </fieldset>
  <fieldset>
    <legend>{{localize "SVNSEA2E.DangerPoints"}}</legend>
    <div class="form-group">
      <label for="svnsea2e-roll-threshold">{{localize "SVNSEA2E.IncreaseThreshold"}}</label>
      <input type="checkbox" id="svnsea2e-roll-threshold" name="increaseThreshold" value="1" />
    </div>
  </fieldset>
</div>
