<h1 class="charname"><input name="name" type="text" value="{{name}}" placeholder="{{localize 'SVNSEA2E.Name'}}" /></h1>
<div class="item-subtitle">{{localize itemType}}</div>
<div class="form-group">
  <label for="{{item.id}}-infosource" class="resource-label">{{localize "SVNSEA2E.Source"}}</label>
  <input name="system.infosource" id="{{item.id}}-infosource" type="text" value="{{infosource}}" />
</div>
