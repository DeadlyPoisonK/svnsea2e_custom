<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}
      <div class="form-group">
        <label for="{{item.id}}-nation">{{localize "SVNSEA2E.Nation"}}</label>
        <select id="{{item.id}}-nation" class="nation" name="system.nation">
          {{selectOptions config.natTypes selected=system.nation localize=true}}
        </select>
      </div>
    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
    <div class="tab {{tabs.quirk.cssClass}}" data-group="primary" data-tab="quirk">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="quirk"}}
    </div>
    <div class="tab details {{tabs.details.cssClass}}" data-group="primary" data-tab="details">
      <h3 class="skill-title">{{localize "SVNSEA2E.Skills"}}</h3>
      <div class="skills flexrow flex-group flex-left">
        <ul class="tag-list">
          {{#each selectedskills as |skill|}}
            <li class="tag">{{skill}}</li>
          {{/each}}
        </ul>
        {{#if editable}}<a class="skill-selector" data-action="selectSkills" data-tooltip="{{localize 'SVNSEA2E.BackgroundSkillSelect'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{/if}}
      </div>
      <h3 class="advantages-title">{{localize "SVNSEA2E.Advantages"}}</h3>
      <div class="advantages flexrow flex-group flex-left">
        <ul class="tag-list">
          {{#each system.advantages as |advantage|}}
            <li class="tag">{{advantage}}</li>
          {{/each}}
        </ul>
        {{#if editable}}<a class="advantage-selector" data-action="selectAdvantages" data-tooltip="{{localize 'SVNSEA2E.BackgroundAdvantageSelect'}}"><i class="fa-solid fa-pen-to-square"></i></a>{{/if}}
      </div>
    </div>
  </section>
</div>
