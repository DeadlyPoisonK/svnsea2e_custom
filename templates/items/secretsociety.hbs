<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}
      <div class="grid grid-5col">
        <div class="flex-group flexrow flex-between favor">
          <label for="{{item.id}}-favor" class="favor-label">{{localize "SVNSEA2E.Favor"}}</label>
          <input type="number" name="system.favor" id="{{item.id}}-favor" value="{{system.favor}}" min="0" step="1" />
        </div>
      </div>
    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
    <div class="tab concern {{tabs.concern.cssClass}}" data-group="primary" data-tab="concern">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="concern"}}
    </div>
    <div class="tab earnfavor {{tabs.earnfavor.cssClass}}" data-group="primary" data-tab="earnfavor">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="earnfavor"}}
    </div>
    <div class="tab callupon {{tabs.callupon.cssClass}}" data-group="primary" data-tab="callupon">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="callupon"}}
    </div>
  </section>
</div>
