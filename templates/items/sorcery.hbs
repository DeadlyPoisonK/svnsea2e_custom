<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}
      <div class="grid grid-2col">
        <div class="form-group flex-group">
          <label for="{{item.id}}-sorctype">{{localize "SVNSEA2E.Type"}}</label>
          <select class="sorcery-type" id="{{item.id}}-sorctype" name="system.sorctype">
            {{selectOptions config.sorceryTypes selected=sorceryType localize=true}}
          </select>
        </div>
        <div class="form-group flex-group">
          <label for="{{item.id}}-sorcdur">{{localize "SVNSEA2E.Duration"}}</label>
          <select class="sorcery-type" id="{{item.id}}-sorcdur" name="system.sorcdur">
            {{selectOptions config.durations selected=sorceryDuration localize=true}}
          </select>
        </div>
      </div>
      <div class="relrep grid grid-2col">
        <div class="form-group flex-group">
          <label for="{{item.id}}-sorccat">{{localize "SVNSEA2E.Category"}}</label>
          <select class="sorcery-category" id="{{item.id}}-sorccat" name="system.sorccat">
            {{selectOptions config.sorceryCats selected=sorceryCategory localize=true}}
          </select>
        </div>
        <div class="form-group flex-group">
          <label for="{{item.id}}-sorcsubcat">{{localize "SVNSEA2E.SubCategory"}}</label>
          <select class="sorcery-subcategory" id="{{item.id}}-sorcsubcat" name="system.sorcsubcat">
            {{selectOptions config.sorcerySubcats selected=sorcerySubCategory localize=true}}
          </select>
        </div>
      </div>
    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
  </section>
</div>
