<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}
      <div class="form-group">
        <label for="{{item.id}}-artifactType">{{localize "SVNSEA2E.Type"}}</label>
        <select class="artifact-type" id="{{item.id}}-artifactType" name="system.artifactType">
          {{selectOptions config.artifactTypes selected=system.artifactType localize=true}}
        </select>
      </div>
    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
  </section>
</div>
