<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}

    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
    <div class="tab attributes {{tabs.attributes.cssClass}}" data-group="primary" data-tab="attributes">
      <div class="form-group cost">
        <label for="{{item.id}}-cost" class="resource-label">{{localize "SVNSEA2E.Cost"}}</label>
        <input name="system.cost.normal" id="{{item.id}}-cost" type="number" value="{{normalCost}}" step="1" />
      </div>
      <div class="form-group">
        <label for="{{item.id}}-reducecost" class="resource-label">{{localize "SVNSEA2E.ReducedCost"}}</label>
        <input name="system.cost.reducecost" id="{{item.id}}-reducecost" type="number" value="{{reducedCost}}" step="1" />
      </div>
      <div class="form-group">
        <label for="{{item.id}}-knack" class="resource-label">{{localize "SVNSEA2E.Knack"}}</label>
        <input type="checkbox" name="system.knack" id="{{item.id}}-knack" {{checked knack}} />
      </div>
      <div class="form-group">
        <label for="{{item.id}}-innate" class="resource-label">{{localize "SVNSEA2E.Innate"}}</label>
        <input type="checkbox" name="system.innate" id="{{item.id}}-innate" {{checked innate}} />
      </div>
    </div>
  </section>
</div>
