<div class="sheet-content flexcol {{cssClass}}">
  <header class="sheet-header">
    <img class="profile-img" src="{{img}}" data-action="editImage" data-edit="img" data-tooltip="{{name}}" alt="{{name}}" />
    <div class="header-fields">
      {{> "systems/svnsea2e/templates/items/parts/item-header.hbs"}}
      <div class="form-group">
        <label for="{{item.id}}-status">{{localize "SVNSEA2E.Status"}}</label>
        <select class="status" id="{{item.id}}-status" name="system.status">
          {{selectOptions config.storyStatuses selected=storyStatus localize=true}}
        </select>
      </div>
    </div>
  </header>
  {{> "systems/svnsea2e/templates/parts/sheet-tabs.hbs"}}
  <section class="sheet-body">
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="description"}}
    </div>
    <div class="tab endings {{tabs.reward.cssClass}}" data-group="primary" data-tab="reward">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="reward"}}
    </div>
    <div class="tab endings {{tabs.endings.cssClass}}" data-group="primary" data-tab="endings">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="endings"}}
    </div>
    <div class="tab steps {{tabs.steps.cssClass}}" data-group="primary" data-tab="steps">
      {{> "systems/svnsea2e/templates/items/parts/item-editor.hbs" field="steps"}}
    </div>
  </section>
</div>
